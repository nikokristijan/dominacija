# --- Produkcija (Supabase) ---
# Ako su ove varijable postavljene, aplikacija koristi Supabase Auth + PostgreSQL.
# Bez njih radi LOKALNI RAZVOJNI NAČIN (datoteka .data/dominacija.json).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SAMO na serveru — nikada ne izlaže u frontend kod!
SUPABASE_SERVICE_ROLE_KEY=

# --- Opće ---
SESSION_SECRET=promijeni-me-u-produkciji
# Zarezom odvojeni popis korisničkih imena/e-mailova administratora
ADMIN_USERS=
# Tajna za cron rutu /api/cron/resolve (Vercel šalje Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
# Dopusti razvojni način (bot igrači, ubrzane runde). Nikada u produkciji.
DEV_MODE=true
# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
